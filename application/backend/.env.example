# Copier ce fichier vers .env et renseigner de vraies valeurs.
# Ne JAMAIS committer le fichier .env réel.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deep_clean?schema=public"

# JWT — générer des secrets forts et distincts, ex: `openssl rand -base64 64`
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
# Session sans "Rester connecté" : courte durée de vie
JWT_REFRESH_EXPIRES_IN_DAYS=1
# Session avec "Rester connecté" activé
JWT_REFRESH_EXPIRES_IN_DAYS_REMEMBER_ME=30

# CORS — origines autorisées séparées par des virgules
CORS_ORIGINS="http://localhost:19006"

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1200
AUTH_RATE_LIMIT_MAX_REQUESTS=10        # échecs de connexion par compte (et par IP)
AUTH_IP_RATE_LIMIT_MAX_REQUESTS=100    # échecs de connexion par IP, tous comptes confondus
HR_RATE_LIMIT_MAX_REQUESTS=100         # créations / activations / réinitialisations de comptes par RH

# Compte administrateur technique créé automatiquement au premier démarrage (seed)
BOOTSTRAP_ADMIN_EMAIL="admin@deepclean.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeNow!2024"

# Stockage des photos (signalements) — chemin local relatif à backend/. Ne pas
# rendre ce dossier public (voir docs/SECURITY.md) : les fichiers sont toujours
# servis via une route authentifiée, jamais par un accès statique direct.
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=8
MAX_DOCUMENT_UPLOAD_SIZE_MB=15

# Notifications push — optionnel, recommandé par Expo en production pour
# fiabiliser l'envoi (https://docs.expo.dev/push-notifications/sending-notifications/#additional-security-with-enhanced-push-security).
# Laisser vide fonctionne aussi : le service push Expo reste utilisable sans jeton.
EXPO_ACCESS_TOKEN=

# --- Mentions légales de l'entreprise (devis, factures, facture électronique) ---
COMPANY_LEGAL_NAME="Deep Clean"
COMPANY_LEGAL_FORM=""          # ex. SAS
COMPANY_SHARE_CAPITAL=""       # ex. 10 000 €
COMPANY_ADDRESS=""             # numéro et rue
COMPANY_POSTAL_CODE=""
COMPANY_CITY=""
COMPANY_SIREN=""               # 9 chiffres
COMPANY_SIRET=""               # 14 chiffres
COMPANY_RCS=""                 # ex. RCS Paris 123 456 789
COMPANY_VAT_NUMBER=""          # ex. FR12123456789
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_IBAN=""
COMPANY_BIC=""
COMPANY_VAT_ON_DEBITS="false"  # true si option pour la TVA d'après les débits
INVOICE_PAYMENT_DAYS=30

# --- Mode maintenance (voir docs/DEPLOYMENT.md §3 quater) ---
# true : plus personne ne peut se connecter (sauf l'admin technique), écran
# « Mise à jour en cours » dans l'app. Remettre à false puis Restart.
MAINTENANCE_MODE="false"
MAINTENANCE_UNTIL=""            # heure de retour prévue, ex. 15:30 (facultatif)
MAINTENANCE_MESSAGE=""          # message personnalisé (facultatif)

# --- Facture électronique (plateforme agréée Super PDP) ---
# Identifiants « client credentials » de l'espace Super PDP (bac à sable ou réel).
SUPERPDP_CLIENT_ID=""
SUPERPDP_CLIENT_SECRET=""

# --- Envoi des emails (devis, factures, relances) ---
# Gmail : SMTP_HOST="smtp.gmail.com", port 587, SMTP_SECURE="false", et un
# « mot de passe d'application » Google (Compte Google → Sécurité → Validation
# en deux étapes → Mots de passe des applications), jamais le mot de passe du
# compte. Sans SMTP_HOST, aucun email ne part réellement (mode simulation).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""                   # ex. "Deep Clean <contact@deepclean.fr>"

# --- Réception des réponses aux devis (lecture de la boîte mail) ---
# Gmail : IMAP_HOST="imap.gmail.com", même adresse et même mot de passe
# d'application que ci-dessus. L'application lit les nouveaux emails toutes les
# 5 minutes, repère les réponses aux devis (numéro DEV-AAAA-NNNN) et prévient le
# commercial. Elle ne supprime ni ne marque jamais un email comme lu.
IMAP_HOST=""
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
