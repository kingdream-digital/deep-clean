# Copier vers .env.test pour lancer les tests (npm test) contre la base de test dédiée
# démarrée par `docker compose up -d db_test` (voir docker-compose.yml à la racine).

NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/deep_clean_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret-please-change-32chars"
JWT_REFRESH_SECRET="test-refresh-secret-please-change-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=1
JWT_REFRESH_EXPIRES_IN_DAYS_REMEMBER_ME=30

CORS_ORIGINS="http://localhost:19006"

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=1000
