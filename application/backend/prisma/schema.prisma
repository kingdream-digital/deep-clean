// Deep Clean — schema de base de données
// Couvre l'ensemble des entités prévues par le cahier des charges (section 19).
// Seuls les modules Auth / Users / Notifications / ActivityLog ont une API pour le moment.
// Les autres modèles (Site, Mission, Problem, Validation, Photo...) posent les fondations
// pour les prochaines itérations sans être exposés par des endpoints encore.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes & rôles
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE // Employé
  SITE_MANAGER // Chef d'équipe
  SUPERVISOR // Superviseur : valide les pointages (avant transmission à la RH) et gère le planning
  HR // RH
  DIRECTOR // Directeur
  ADMIN // Administrateur technique
}

model User {
  id                 String    @id @default(uuid())
  // Identifiant de connexion — jamais l'email (retour explicite du client) :
  // généré côté serveur à la création du compte, à partir de la première
  // lettre du prénom suivie du nom (ex. "Jean Dupont" -> "jdupont"), avec un
  // suffixe numérique en cas de collision (voir utils/username.ts). RH le
  // communique à l'utilisateur comme son identifiant, au même titre que le
  // mot de passe temporaire.
  username           String    @unique
  // Conservé comme coordonnée de contact (annuaire, export PDF) mais n'a plus
  // aucun rôle dans l'authentification — optionnel désormais, RH n'a plus à
  // en fournir un à la création du compte.
  email              String?   @unique
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  firstName          String
  lastName           String
  phone              String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true) // vrai tant que le mot de passe temporaire fourni par la RH n'a pas été changé
  // Photo de profil facultative (retour explicite du client : l'utilisateur
  // doit pouvoir en mettre une, en changer, ou ne pas en avoir du tout) —
  // clé opaque vers utils/storage.ts, jamais une URL publique permanente ;
  // l'image est servie via une route authentifiée comme les autres photos.
  avatarKey          String?
  lastLoginAt        DateTime?
  // Moteur de congés (retour explicite du client) — date d'embauche : point
  // de départ de l'acquisition, jamais modifiée automatiquement ensuite ;
  // par défaut la date de création du compte si non précisée (voir
  // users.service.ts::createUser). leaveAccrualRate/leaveAccrualCap :
  // configurables PAR SALARIÉ par la RH/direction (temps partiel, avenant...)
  // — null = valeur par défaut de l'entreprise (DEFAULT_LEAVE_ACCRUAL_RATE_PER_MONTH,
  // aucun plafond). Voir leave.service.ts pour le calcul (jamais une règle
  // figée dans le code).
  hireDate           DateTime  @default(now())
  leaveAccrualRate   Float?
  leaveAccrualCap    Float?
  createdById        String? // RH ayant créé le compte
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  pushTokens         PushToken[]
  notifications      Notification[]
  managedSites       Site[]              @relation("SiteManager")
  supervisedSites    Site[]              @relation("SiteSupervisor")
  siteMemberships    SiteMember[]
  missionAssignments MissionAssignment[]
  createdMissions    Mission[]           @relation("MissionCreatedBy")
  uploadedMissionStandardDocuments Mission[] @relation("MissionStandardDocumentUploadedBy")
  uploadedStandardDocuments CleaningStandard[] @relation("StandardDocumentUploadedBy")
  reportedProblems   Problem[]           @relation("ProblemReportedBy")
  problemComments    ProblemComment[]
  uploadedPhotos     Photo[]
  validations        Validation[]
  activityLogs       ActivityLog[]
  timeEntries        TimeEntry[]         @relation("TimeEntryUser")
  validatedTimeEntries TimeEntry[]       @relation("TimeEntryValidatedBy")
  createdJobSheets   JobSheet[]          @relation("JobSheetCreatedBy")
  createdStandards   CleaningStandard[]  @relation("StandardCreatedBy")
  sentMessages       Message[]           @relation("MessageSender")
  receivedMessages   Message[]           @relation("MessageRecipient")
  absences           Absence[]           @relation("AbsenceUser")
  decidedAbsences    Absence[]           @relation("AbsenceDecidedBy")
  leaveTransactions        LeaveTransaction[] @relation("LeaveTransactionUser")
  createdLeaveTransactions LeaveTransaction[] @relation("LeaveTransactionCreatedBy")
  postedAnnouncements Announcement[]     @relation("AnnouncementAuthor")
  employeeDocuments   EmployeeDocument[] @relation("EmployeeDocumentOwner")
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  assignedProspects   Prospect[]         @relation("ProspectAssignedUser")
  createdProspects    Prospect[]         @relation("ProspectCreatedBy")
  createdClients      Client[]           @relation("ClientCreatedBy")
  assignedQuotes      Quote[]            @relation("QuoteAssignedUser")
  createdQuotes       Quote[]            @relation("QuoteCreatedBy")
  acceptedQuotes      Quote[]            @relation("QuoteAcceptedBy")
  rejectedQuotes      Quote[]            @relation("QuoteRejectedBy")
  quoteEvents         QuoteEvent[]       @relation("QuoteEventUser")
  createdSiteTargets  SiteTarget[]       @relation("SiteTargetCreatedBy")
  createdInvoices     Invoice[]          @relation("InvoiceCreatedBy")

  @@index([role])
  @@map("users")
}

/// Sessions / refresh tokens — permet "Rester connecté" et une déconnexion réelle (invalidation serveur)
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique // le refresh token n'est jamais stocké en clair
  userAgent        String?
  ipAddress        String?
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Chantiers / équipes
// ---------------------------------------------------------------------------

model Site {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  managerId   String?
  manager     User?    @relation("SiteManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Superviseur du chantier — retour explicite du client : distinct du chef
  // d'équipe (`managerId`, ou le chef d'équipe désigné mission par mission
  // via `MissionAssignment.isLead`), qui PEUT varier d'un jour à l'autre.
  // Le superviseur du chantier, lui, ne change pas : c'est le même
  // interlocuteur fixe pour ce chantier. N'ajoute aucune permission propre :
  // tout compte au rôle Superviseur peut déjà gérer n'importe quel chantier
  // (voir sites.service.ts) — purement organisationnel/informatif, pour que
  // l'équipe sache qui est le superviseur référent de CE chantier précis.
  supervisorId String?
  supervisor   User?    @relation("SiteSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  // Photo du chantier (retour explicite du client : "pour qu'on ait un
  // visuel directement") — même principe que les autres photos de l'app :
  // jamais une URL publique, clé opaque résolue par une route authentifiée
  // dédiée (voir sites.service.ts `getSitePhotoFile`). Optionnelle : un
  // chantier sans photo garde son icône générique (voir SiteDetailScreen).
  photoKey    String?
  isActive    Boolean  @default(true)
  // Position GPS du chantier, enregistrée une fois sur place (bouton "Utiliser
  // ma position actuelle" à la création/édition de la fiche) — retour explicite
  // du client : permet de vérifier automatiquement, EN INTERNE (aucun service
  // de géocodage tiers), qu'un pointage a bien été fait à proximité du
  // chantier prévu (voir timesheets.service.ts, calcul de distance à vol
  // d'oiseau). Optionnelle : les chantiers créés avant cette fonctionnalité
  // n'en ont pas, et la vérification de distance ne s'applique alors pas.
  latitude    Float?
  longitude   Float?
  // Lien commercial optionnel (cahier des charges module commercial, §19-21)
  // — un chantier "opérationnel" classique n'a besoin d'aucun des deux ;
  // remplis uniquement quand le chantier a été créé à partir d'un devis
  // accepté (action humaine explicite, voir sites.service.ts::createSite).
  // Jamais rempli automatiquement par l'acceptation du devis elle-même.
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quoteId     String?  @unique
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           SiteMember[]
  missions          Mission[]
  problems          Problem[]
  cleaningStandards CleaningStandard[]
  targets           SiteTarget[]
  invoices          Invoice[]

  @@map("sites")
}

enum SiteBillingMode {
  FLAT_RATE // forfait (montant prévu au devis)
  PER_SERVICE // à la prestation (nombre réel de prestations facturables × tarif)
}

/// Objectif mensuel d'un chantier (cahier des charges §22 : "suivi manuel des
/// objectifs") — défini MANUELLEMENT par le responsable, jamais déduit
/// automatiquement du devis (même s'il peut s'en inspirer). Le "réalisé" ne
/// se calcule pas ici : il est recalculé à la volée depuis les missions
/// réelles du chantier sur la période (voir sites.service.ts::getSiteProgress)
/// pour ne jamais désynchroniser prévision et réalisation.
model SiteTarget {
  id            String          @id @default(uuid())
  siteId        String
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Format "AAAA-MM" — un objectif par chantier et par mois.
  period        String
  plannedVisits Int
  plannedHours  Float?
  plannedAmount Float?
  billingMode   SiteBillingMode @default(FLAT_RATE)
  createdById   String
  createdBy     User            @relation("SiteTargetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([siteId, period])
  @@map("site_targets")
}

/// Standard de nettoyage réutilisable pour un chantier/client donné — préparé
/// à l'avance par le superviseur ou la RH, puis appliqué en un clic à la
/// création d'une mission sur ce chantier (copie son contenu dans la fiche de
/// poste de la mission, voir `missions.service.ts` / `createMission`).
model CleaningStandard {
  id                 String   @id @default(uuid())
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name               String
  tasks              String[]
  equipment          String[]
  safetyInstructions String?
  notes              String?
  createdById        String
  createdBy          User     @relation("StandardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Document PDF déposé directement sur le standard (retour explicite du
  // client : il a déjà son propre standard en PDF, pas besoin de le retaper
  // dans tasks/equipment) — même mécanique que Mission.standardDocumentKey
  // ci-dessus : jamais exposé au client (route authentifiée dédiée), un seul
  // document à la fois, le redéposer remplace le précédent.
  documentKey          String?
  documentFileName     String?
  documentSizeBytes    Int?
  documentUploadedById String?
  documentUploadedBy   User?     @relation("StandardDocumentUploadedBy", fields: [documentUploadedById], references: [id], onDelete: SetNull)
  documentUploadedAt   DateTime?

  missions Mission[]

  @@map("cleaning_standards")
}

model SiteMember {
  id       String   @id @default(uuid())
  siteId   String
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([siteId, userId])
  @@map("site_members")
}

// ---------------------------------------------------------------------------
// Planning / missions
// ---------------------------------------------------------------------------

enum MissionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Mission {
  id           String        @id @default(uuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime      @db.Date
  startTime    DateTime
  endTime      DateTime
  instructions String?
  status       MissionStatus @default(SCHEDULED)
  createdById  String
  createdBy    User          @relation("MissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // Standard de nettoyage appliqué à la création (traçabilité) — son contenu
  // a été copié dans `JobSheet` au moment de la création, donc conservé même
  // si le standard est modifié ou supprimé depuis (onDelete: SetNull).
  standardId   String?
  standard     CleaningStandard? @relation(fields: [standardId], references: [id], onDelete: SetNull)
  // Document PDF déposé directement sur la mission (ex. standard de nettoyage
  // du client, fiche technique produit) — distinct du `CleaningStandard`
  // structuré ci-dessus (`standard`/`standardId`) : un fichier tel quel,
  // visible par l'équipe affectée en plus de la consigne (`instructions`),
  // jamais de contenu structuré à maintenir. Un seul document par mission :
  // le déposer à nouveau remplace le précédent (voir missions.service.ts
  // `attachStandardDocument`). `standardDocumentKey` n'est jamais exposé au
  // client (mêmes règles que `Photo.storageKey`) — seule une route
  // authentifiée dédiée sert le fichier.
  standardDocumentKey          String?
  standardDocumentFileName     String?
  standardDocumentSizeBytes    Int?
  standardDocumentUploadedById String?
  standardDocumentUploadedBy   User?     @relation("MissionStandardDocumentUploadedBy", fields: [standardDocumentUploadedById], references: [id], onDelete: SetNull)
  standardDocumentUploadedAt   DateTime?
  // Regroupe les occurrences générées ensemble par une mission récurrente
  // (retour explicite du client : "pas besoin de le recréer à chaque fois",
  // voir missions.service.ts `createMission`/`generateRecurringDates`) — nul
  // pour une mission ponctuelle. Partagé par la mission "source" et toutes
  // ses occurrences, permet d'annuler la série entière en un geste
  // (`cancelMission` avec `scope: "series"`) plutôt qu'occurrence par
  // occurrence.
  recurrenceGroupId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments MissionAssignment[]
  problems    Problem[]
  validations Validation[]
  jobSheet    JobSheet?

  @@index([siteId, date])
  @@index([recurrenceGroupId])
  @@map("missions")
}

/// Fiche de poste : document standard décrivant comment réaliser la mission
/// (étapes, matériel, consignes de sécurité) — créé par le superviseur (ou
/// tout rôle habilité à gérer le planning), consultable par les employés
/// affectés. Un seul par mission : sert de référence standardisée plutôt que
/// les instructions libres du champ `Mission.instructions`.
model JobSheet {
  id                 String   @id @default(uuid())
  missionId          String   @unique
  mission            Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tasks              String[]
  equipment          String[]
  safetyInstructions String?
  notes              String?
  createdById        String
  createdBy          User     @relation("JobSheetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("job_sheets")
}

model MissionAssignment {
  id        String   @id @default(uuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([missionId, userId])
  @@index([userId])
  @@map("mission_assignments")
}

// ---------------------------------------------------------------------------
// Signalements de problèmes
// ---------------------------------------------------------------------------

enum ProblemStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  VALIDATED
}

enum ProblemType {
  ISSUE // problème général (dégât, sécurité, accès...)
  MISSING_MATERIAL // matériel manquant
}

model Problem {
  id           String        @id @default(uuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  missionId    String?
  mission      Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  reportedById String
  reportedBy   User          @relation("ProblemReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  type         ProblemType   @default(ISSUE)
  description  String
  status       ProblemStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  photos      Photo[]
  comments    ProblemComment[]
  validations Validation[]

  @@map("problems")
}

model ProblemComment {
  id        String   @id @default(uuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comment   String
  createdAt DateTime @default(now())

  @@map("problem_comments")
}

// ---------------------------------------------------------------------------
// Fichiers / photos — accès contrôlé, jamais d'URL publique permanente
// ---------------------------------------------------------------------------

model Photo {
  id           String   @id @default(uuid())
  storageKey   String   @unique // clé privée dans le stockage objet (jamais exposée telle quelle)
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  problemId    String?
  problem      Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Horodatage du rappel envoyé à la RH avant suppression automatique — évite
  // de renvoyer le même rappel chaque jour (voir jobs/photoRetention.ts).
  purgeWarnedAt DateTime?

  @@map("photos")
}

// ---------------------------------------------------------------------------
// Validations
// ---------------------------------------------------------------------------

enum ValidationType {
  MISSION_COMPLETION
  SITE_CLOSURE
  PROBLEM_RESOLUTION
  ACCOUNT_CHANGE
  OTHER
}

model Validation {
  id            String         @id @default(uuid())
  type          ValidationType
  missionId     String?
  mission       Mission?       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  problemId     String?
  problem       Problem?       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  validatedById String
  validatedBy   User           @relation(fields: [validatedById], references: [id], onDelete: Restrict)
  comment       String?
  createdAt     DateTime       @default(now())

  // Empêche au niveau base deux validations concurrentes du même type pour
  // la même mission (double-clic, retry réseau, ou deux validateurs qui
  // valident au même instant) — Postgres traite les NULL comme distincts,
  // donc les validations de type "problème" (missionId toujours NULL)
  // ne sont pas concernées par cette contrainte.
  @@unique([missionId, type])
  @@map("validations")
}

// ---------------------------------------------------------------------------
// Pointage (feuilles d'heures)
// ---------------------------------------------------------------------------

enum TimeEntryStatus {
  PENDING // en attente de validation
  VALIDATED
  REJECTED
}

/// Un pointage = une session travaillée (arrivée -> départ). `clockOut` est
/// null tant que l'utilisateur n'a pas pointé sa sortie ; un utilisateur ne
/// peut avoir qu'un seul pointage ouvert à la fois (voir timesheets.service.ts).
model TimeEntry {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  clockIn       DateTime
  clockOut      DateTime?
  status        TimeEntryStatus @default(PENDING)
  validatedById String?
  validatedBy   User?           @relation("TimeEntryValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt   DateTime?
  comment       String?
  isRetroactive Boolean         @default(false) // pointage saisi après coup (oubli), signalé pour le validateur
  // Justificatif anti-fraude (retour explicite du client) : photo + position GPS
  // capturées sur le terrain au moment même du pointage, jamais saisies après
  // coup (absentes sur un pointage différé, `isRetroactive`, par construction —
  // il n'y a alors personne sur place pour les capturer). `storageKey` suit le
  // même principe que `Photo.storageKey` : jamais d'URL publique, toujours
  // servi via une route authentifiée qui revérifie les permissions.
  clockInLatitude   Float?
  clockInLongitude  Float?
  clockInAccuracy   Float? // précision GPS en mètres fournie par l'appareil, pour que le validateur juge la fiabilité du point
  clockInPhotoKey   String?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  clockOutAccuracy  Float?
  clockOutPhotoKey  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, clockIn])
  @@map("time_entries")
}

// ---------------------------------------------------------------------------
// Congés & absences
// ---------------------------------------------------------------------------

enum AbsenceType {
  PAID_LEAVE // Congé payé
  SICK_LEAVE // Arrêt maladie
  UNPAID_LEAVE // Congé sans solde
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  // Un congé déjà validé peut être annulé (retour explicite du client,
  // section "Modification et annulation") — jamais réutilisé pour un simple
  // refus, qui reste REJECTED : CANCELLED suppose une validation préalable et
  // un recrédit du solde (voir leave.service.ts::cancelLeave).
  CANCELLED
}

/// Demande d'absence planifiée (congé, maladie...) — distincte du pointage
/// (TimeEntry, qui constate une présence réelle) : ceci est une INDISPONIBILITÉ
/// à venir ou en cours, décidée par la RH, et croisée avec le planning des
/// missions pour détecter automatiquement les conflits (voir
/// absences.service.ts `decideAbsence` et missions.service.ts
/// `getAssignmentConflicts`).
model Absence {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("AbsenceUser", fields: [userId], references: [id], onDelete: Cascade)
  type         AbsenceType   @default(PAID_LEAVE)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       AbsenceStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("AbsenceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  leaveTransactions LeaveTransaction[]

  @@index([userId, startDate, endDate])
  @@index([status])
  @@map("absences")
}

// ---------------------------------------------------------------------------
// Moteur de congés — compteur et historique (retour explicite du client)
// ---------------------------------------------------------------------------

// Le solde "acquis" n'est jamais stocké : recalculé à la volée à partir de
// User.hireDate/leaveAccrualRate/leaveAccrualCap (voir leave.service.ts) —
// c'est une formule déterministe, pas un compteur qui pourrait dériver.
// Seuls les ÉVÉNEMENTS qui modifient réellement le solde disponible sont
// journalisés ici, pour une traçabilité complète ("comprendre l'origine
// exacte du solde de chaque salarié").
enum LeaveTransactionType {
  LEAVE_TAKEN // congé validé : jours déduits (days négatif)
  LEAVE_CANCELLED // congé annulé après validation : jours recrédités (days positif)
  ADJUSTMENT // correction manuelle RH (days positif ou négatif)
}

model LeaveTransaction {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation("LeaveTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  type        LeaveTransactionType
  // Signé : négatif = déduction, positif = crédit — permet un simple SUM()
  // pour retrouver l'impact net sur le solde d'une période donnée.
  days        Float
  occurredAt  DateTime             @default(now())
  absenceId   String?
  absence     Absence?             @relation(fields: [absenceId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User                 @relation("LeaveTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime             @default(now())

  @@index([userId, occurredAt])
  @@map("leave_transactions")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  MISSION_ASSIGNED
  MISSION_UNASSIGNED
  MISSION_TIME_CHANGED
  MISSION_SITE_CHANGED
  MISSION_CANCELLED
  MISSION_INSTRUCTION_ADDED
  PROBLEM_UPDATE
  PHOTO_EXPIRING_SOON
  VALIDATION_REQUESTED
  TIMESHEET_VALIDATED
  ACCOUNT_UPDATE
  // Envoyée à la RH/direction/admin quand un employé demande une absence
  // (voir absences.service.ts::notifyAbsenceManagers) — distincte de
  // ABSENCE_DECIDED (envoyée à l'employé une fois la décision prise) pour
  // que l'appui sur la notification puisse amener au bon endroit : la fiche
  // de l'employé pour valider/refuser ici, "Mes absences" là.
  ABSENCE_REQUESTED
  ABSENCE_DECIDED
  ABSENCE_CONFLICT
  // Congé déjà validé puis annulé (retour explicite du client) — distincte
  // d'ABSENCE_DECIDED, qui porte la toute première décision.
  ABSENCE_CANCELLED
  // Diffusée à toute l'entreprise quand la RH, un superviseur, la direction
  // ou l'admin publie une actualité (retour explicite du client) — jamais
  // envoyée à l'auteur lui-même.
  ANNOUNCEMENT_POSTED
  // Retour explicite du client : "je veux une cloche de notification" —
  // jusqu'ici un nouveau message envoyait une alerte push directe sans
  // jamais créer d'entrée dans le centre de notifications (voir
  // messages.service.ts::sendMessage), au motif que le badge de non-lus de
  // l'onglet Messagerie suffisait déjà. Le client veut la cloche en plus.
  MESSAGE_RECEIVED
  GENERAL
}

/// Actualités internes (retour explicite du client) — publiées par la RH, un
/// superviseur, la direction ou l'admin, visibles par toute l'entreprise.
/// Diffuse une notification à tous les comptes actifs à la création (voir
/// announcements.service.ts) ; pas de brouillon ni d'édition dans cette
/// première version — publier, c'est notifier immédiatement.
model Announcement {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // Photo de couverture facultative (retour explicite du client : "un vrai
  // blog/journal d'entreprise", une photo en tête d'actualité) — même
  // principe que les autres photos de l'app, jamais d'URL publique, servie
  // via une route authentifiée dédiée.
  coverPhotoKey String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("announcements")
}

// Espace documents personnel (retour explicite du client) : la RH/direction y
// dépose un document (contrat, avenant...) directement dans l'espace d'un
// employé, qui peut ensuite le consulter/télécharger depuis son profil —
// une simple liste par personne, comme les photos de signalement, jamais de
// notion de dossier/catégorie.
model EmployeeDocument {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("EmployeeDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  storageKey   String
  fileName     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("employee_documents")
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

/// Jetons push (Expo/FCM/APNs) — la logique d'envoi sera branchée dans une itération suivante
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// Messagerie interne
// ---------------------------------------------------------------------------

/// Message direct entre deux comptes de l'entreprise — pas de notion de
/// "conversation" en base : un fil entre deux utilisateurs se déduit en
/// filtrant sur (senderId, recipientId) dans les deux sens (voir
/// messages.service.ts), plutôt qu'une entité séparée à maintenir en plus.
model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // Optionnel depuis l'ajout de la photo jointe (retour explicite du client)
  // : un message peut être une photo seule, sans texte — jamais les deux
  // absents à la fois (voir messages.service.ts::sendMessage).
  body        String?
  // Photo jointe au message (retour explicite du client) — même principe que
  // les autres photos de l'app : jamais d'URL publique, clé opaque résolue
  // par une route authentifiée dédiée (voir messages.service.ts
  // `getMessagePhoto`), réservée à l'expéditeur et au destinataire.
  photoKey    String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, isRead])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Journal d'activité
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Module commercial — prospection / clients (cahier des charges "Module
// commercial / devis / chantiers / facturation", phase 3). Le client final
// n'a JAMAIS de compte DeepClean ni d'accès à l'application : Prospect et
// Client ne sont que des fiches internes gérées par Direction / RH /
// Superviseur (voir prospects.service.ts / clients.service.ts pour le détail
// des permissions — RH a le même niveau d'accès complet que la Direction,
// le Superviseur est restreint à ses propres prospects).
// ---------------------------------------------------------------------------

enum ProspectStatus {
  NEW // Nouveau
  CONTACTED // Contacté
  MEETING_SCHEDULED // Rendez-vous
  QUOTE_TO_PREPARE // Devis à préparer
  QUOTE_SENT // Devis envoyé
  NEGOTIATING // En négociation
  WON // Gagné
  LOST // Perdu
}

model Prospect {
  id               String         @id @default(uuid())
  companyName      String
  contactFirstName String?
  contactLastName  String?
  jobTitle         String?
  phone            String?
  email            String?
  address          String?
  postalCode       String?
  city             String?
  siret            String?
  source           String?
  need             String?
  serviceType      String?
  notes            String?
  status           ProspectStatus @default(NEW)
  nextFollowUpAt   DateTime?
  // Commercial responsable — un superviseur ne peut s'assigner qu'à
  // lui-même ; seuls RH/Direction/Admin peuvent réassigner un prospect à un
  // autre commercial (voir prospects.service.ts::resolveAssignedUserId).
  assignedUserId String?
  assignedUser   User?    @relation("ProspectAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User     @relation("ProspectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Rempli une fois le prospect transformé en client (voir
  // prospects.service.ts::convertProspectToClient) — jamais recréé à la
  // main, les coordonnées sont reprises telles quelles.
  client Client?

  @@index([assignedUserId])
  @@index([status])
  @@map("prospects")
}

/// Un client n'a jamais de compte DeepClean — coordonnées internes utilisées
/// pour générer devis/factures PDF et rattacher les chantiers. Peut provenir
/// d'un prospect transformé (prospectId) ou être créé directement.
model Client {
  id               String    @id @default(uuid())
  companyName      String
  contactFirstName String?
  contactLastName  String?
  jobTitle         String?
  phone            String?
  email            String?
  billingAddress   String?
  postalCode       String?
  city             String?
  siret            String?
  notes            String?
  prospectId       String?   @unique
  prospect         Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User      @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  quotes   Quote[]
  sites    Site[]
  invoices Invoice[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// Module commercial — devis (phase 4-7 du cahier des charges). Un devis
// accepté ne crée JAMAIS automatiquement de chantier, de mission ou
// d'événement de planning (règle absolue, §25/§40) : la création du chantier
// et des missions reste une action humaine, toujours déclenchée depuis un
// bouton explicite (voir sites.service.ts / missions.service.ts, phase 8-10).
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT // Brouillon
  TO_VALIDATE // À valider
  VALIDATED // Validé
  SENT // Envoyé
  FOLLOW_UP // Relance en cours
  ACCEPTED // Accepté
  REJECTED // Refusé
  EXPIRED // Expiré
}

enum QuoteItemUnit {
  HOUR // heure
  DAY // jour
  INTERVENTION // intervention
  SQUARE_METER // m²
  FLAT_RATE // forfait
  MONTH // mois
  OTHER // autre
}

enum QuoteItemFrequency {
  ONE_TIME // ponctuelle
  DAILY // quotidienne
  MULTIPLE_PER_WEEK // plusieurs fois par semaine
  WEEKLY // hebdomadaire
  MULTIPLE_PER_MONTH // plusieurs fois par mois
  MONTHLY // mensuelle
  CUSTOM // personnalisée
}

enum QuoteFollowUpMethod {
  EMAIL
  PHONE
  SMS
  MEETING // rendez-vous
  OTHER
}

enum QuoteEventAction {
  CREATED
  UPDATED
  SUBMITTED_FOR_VALIDATION
  VALIDATED
  SENT
  FOLLOW_UP
  ACCEPTED
  REJECTED
  EXPIRED
  NEW_VERSION_CREATED
}

model Quote {
  id             String      @id @default(uuid())
  // Format DEV-AAAA-NNNN (voir quotes.service.ts::generateQuoteNumber) —
  // jamais réutilisé, y compris pour une nouvelle version (voir
  // previousVersionId ci-dessous).
  quoteNumber    String      @unique
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // "Commercial" responsable du devis (cahier des charges §9) — distinct du
  // créateur : un superviseur ne peut s'assigner qu'à lui-même, seuls
  // RH/Direction/Admin peuvent réassigner (même règle que Prospect.assignedUserId).
  assignedUserId String?
  assignedUser   User?       @relation("QuoteAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  status         QuoteStatus @default(DRAFT)
  issueDate      DateTime    @default(now())
  validUntil     DateTime?
  subject        String?
  // Coordonnées "figées" au moment de la création — un devis déjà envoyé ne
  // doit jamais changer silencieusement si la fiche client est modifiée
  // ensuite (le PDF déjà transmis au client doit rester cohérent avec ce que
  // l'application affiche). Reprises du client à la création, modifiables
  // tant que le devis est en BROUILLON.
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  billingAddress String?
  siret          String?
  // Adresse du CHANTIER visé par le devis — distincte de l'adresse de
  // facturation ci-dessus (cahier des charges §9).
  siteAddress    String?
  description    String?
  paymentTerms   String?
  // Jamais inclus dans le PDF client (cahier des charges §9/§15) — voir
  // quotes.pdf.ts::buildQuotePdf, qui ne lit jamais ce champ.
  internalNotes  String?

  // Montants recalculés côté serveur à chaque création/modification des
  // lignes (jamais fournis par le client — cahier des charges §13) : voir
  // quotes.service.ts::recomputeQuoteTotals.
  subtotalHt      Float @default(0)
  // Remise globale, en montant HT (pas un pourcentage) — appliquée après le
  // sous-total des lignes.
  discount        Float @default(0)
  vatRate         Float @default(20)
  vatAmount       Float @default(0)
  totalTtc        Float @default(0)
  // Somme des `monthlyAmountHt` des lignes récurrentes — "montant
  // prévisionnel" du §11/§13, jamais une facturation réelle.
  monthlyAmountHt Float @default(0)

  // Relance (§17) — dernière/prochaine relance en un coup d'œil, l'historique
  // complet est dans QuoteEvent ci-dessous.
  nextFollowUpAt DateTime?

  // Acceptation manuelle (§18) — jamais déclenchée par le client lui-même.
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?                 @relation("QuoteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedMethod  QuoteFollowUpMethod?
  acceptedComment String?

  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("QuoteRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedComment String?

  // Versionnage (§14 : "toute modification importante doit créer une
  // nouvelle version") — un devis non-brouillon est verrouillé ; le modifier
  // crée une copie DRAFT distincte pointant vers l'original via ce champ,
  // plutôt que de réécrire l'historique déjà envoyé au client.
  previousVersionId String? @unique
  previousVersion   Quote?  @relation("QuoteVersion", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion       Quote?  @relation("QuoteVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    QuoteItem[]
  events   QuoteEvent[]
  // Chantier créé à partir de ce devis accepté (§19-21) — jamais rempli
  // automatiquement, uniquement via l'action humaine "Créer un chantier à
  // partir du devis" (voir sites.service.ts::createSite).
  site     Site?
  invoices Invoice[]

  @@index([clientId])
  @@index([assignedUserId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String        @id @default(uuid())
  quoteId     String
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        QuoteItemUnit
  unitPriceHt Float
  // Pourcentage 0-100, jamais un montant absolu (distinct de Quote.discount).
  discount    Float         @default(0)
  // Recalculé côté serveur : quantity * unitPriceHt * (1 - discount / 100).
  totalHt     Float         @default(0)

  frequency QuoteItemFrequency @default(ONE_TIME)
  // Nombre de passages par mois — requis dès que `frequency` n'est pas
  // ONE_TIME (ex. "6 passages par mois", cahier des charges §11). Sert à
  // calculer `monthlyAmountHt` ci-dessous, jamais à déduire une date de
  // planning : purement prévisionnel/informatif (§12).
  occurrencesPerMonth Float?
  // Recalculé côté serveur : totalHt * occurrencesPerMonth si récurrent,
  // sinon 0 (une ligne ponctuelle n'entre pas dans le prévisionnel mensuel).
  monthlyAmountHt     Float  @default(0)

  // Sert de référence au futur chantier (§12) — jamais utilisé pour créer
  // quoi que ce soit automatiquement.
  estimatedHours     Float?
  estimatedEmployees Int?
  sortOrder          Int    @default(0)

  @@index([quoteId])
  @@map("quote_items")
}

/// Historique et relances (§17/§42) — chaque changement de statut et chaque
/// relance enregistrée créent une ligne ici, jamais modifiée ni supprimée
/// ensuite (traçabilité).
model QuoteEvent {
  id        String               @id @default(uuid())
  quoteId   String
  quote     Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation("QuoteEventUser", fields: [userId], references: [id], onDelete: Restrict)
  action    QuoteEventAction
  method    QuoteFollowUpMethod?
  comment   String?
  metadata  Json?
  createdAt DateTime             @default(now())

  @@index([quoteId])
  @@map("quote_events")
}

// ---------------------------------------------------------------------------
// Module commercial — facturation (phase 11-12 du cahier des charges).
// FACTURATION ≠ PLANNING (§29/§40) : une facture ne crée, ne modifie ni ne
// supprime jamais de mission, de chantier ou d'événement de planning.
// Réservée à RH/Direction/Admin (le Superviseur ne figure pas dans la liste
// de permissions "facturation" du cahier des charges, §1-3) — voir
// invoices.routes.ts.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT // À préparer
  VALIDATED // Validée
  SENT // Envoyée
  PAID // Payée
  CANCELLED // Annulée
}

model Invoice {
  id            String        @id @default(uuid())
  // Format FAC-AAAA-NNNN (voir invoices.service.ts::generateInvoiceNumber).
  invoiceNumber String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Références optionnelles (§31 : "La facture doit conserver une référence
  // au devis [...] et éventuellement au chantier") — une facture peut aussi
  // être créée directement pour un client, sans devis ni chantier.
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  siteId        String?
  site          Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  status        InvoiceStatus @default(DRAFT)
  // Mode défini au moment de la génération (§33) : FLAT_RATE reprend le
  // montant prévu (devis/objectif), PER_SERVICE se base sur le nombre réel de
  // prestations réalisées sur la période × tarif — le calcul lui-même est
  // fait une fois, à la création (voir invoices.service.ts), jamais recalculé
  // après coup pour ne pas faire varier une facture déjà émise.
  billingMode   SiteBillingMode @default(FLAT_RATE)
  // Mois facturé le cas échéant ("AAAA-MM") — pour une facture mensuelle liée
  // à un chantier récurrent.
  period        String?
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  // Coordonnées figées au moment de la création (même principe que
  // Quote.contactName et consorts — jamais relues depuis la fiche client
  // après coup).
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  billingAddress String?
  siret          String?
  paymentTerms   String?
  // Jamais inclus dans le PDF client (même règle que Quote.internalNotes).
  internalNotes  String?

  subtotalHt Float @default(0)
  vatRate    Float @default(20)
  vatAmount  Float @default(0)
  totalTtc   Float @default(0)

  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  cancelledComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id                String        @id @default(uuid())
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description       String
  quantity          Float
  unit              QuoteItemUnit
  unitPriceHt       Float
  // Recalculé côté serveur : quantity * unitPriceHt (même principe que
  // QuoteItem.totalHt — jamais fait confiance à un total envoyé par le client).
  totalHt           Float         @default(0)
  // Ligne de devis d'origine, le cas échéant (§38) — purement informatif,
  // pour tracer d'où vient un montant facturé.
  sourceQuoteItemId String?
  sortOrder         Int           @default(0)

  @@index([invoiceId])
  @@map("invoice_items")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
