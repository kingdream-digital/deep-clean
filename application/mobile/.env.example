# Copier vers .env. Les variables EXPO_PUBLIC_* sont injectées au build,
# donc jamais utilisées pour un vrai secret (uniquement l'URL publique de l'API).
#
# - Simulateur iOS / émulateur Android sur la même machine que le backend : localhost fonctionne.
# - Téléphone physique via Expo Go : remplacer par l'IP locale de votre machine (ex: 192.168.1.20)
#   et vérifier que le téléphone est sur le même réseau Wi-Fi.
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
