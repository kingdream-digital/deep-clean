{
  "expo": {
    "name": "Deep Clean",
    "slug": "deep-clean",
    "scheme": "deepclean",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepclean.app"
    },
    "android": {
      "package": "com.deepclean.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0B0F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "fr",
      "shortName": "Deep Clean",
      "themeColor": "#0E7490",
      "backgroundColor": "#0B0B0F",
      "display": "standalone"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F",
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Deep Clean a besoin d'accéder à vos photos pour joindre une image à un signalement.",
          "cameraPermission": "Deep Clean a besoin d'accéder à l'appareil photo pour prendre une photo à joindre à un signalement ou pour justifier un pointage."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Deep Clean a besoin de votre position au moment où vous pointez, pour justifier que vous étiez bien sur le lieu de la mission."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/mark-white.png",
          "color": "#0E7490"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-asset"
    ]
  }
}
