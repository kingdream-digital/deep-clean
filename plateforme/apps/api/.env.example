# Copier en .env puis remplacer chaque secret (openssl rand -base64 48).
NODE_ENV=development
PORT=4000
# Rôle SANS privilège, soumis aux politiques RLS (voir infra/db/init/00-roles.sql)
DATABASE_URL=postgresql://aussitot_app:aussitot_app@localhost:5432/aussitot
# Propriétaire du schéma : migrations et jeu de démo uniquement
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/aussitot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=remplacer-par-un-secret-de-48-caracteres-minimum
APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081
PLATFORM_ADMIN_TOKEN=remplacer-par-un-jeton-operateur-de-32-caracteres-minimum

# Assistant (Claude) — sans clé, l'assistant est indiqué comme indisponible
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low

# Emails (en développement sans SMTP : messages journalisés, non envoyés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@aussitot.app

# Stockage : local en développement, s3 dès qu'il y a plusieurs instances
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
