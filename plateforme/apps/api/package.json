{
  "name": "@aussitot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Aussitôt — multi-entreprises, isolation PostgreSQL RLS, assistant IA, devis/factures, planning.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:test:migrate": "DOTENV_CONFIG_PATH=.env.test prisma migrate deploy",
    "platform": "tsx --env-file-if-exists=.env src/cli/platform.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aussitot/shared": "*",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.16.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
