# Copier en .env (jamais versionné) et remplacer CHAQUE valeur.
# Secrets : openssl rand -base64 48
API_DOMAIN=api.exemple.fr
APP_DOMAIN=app.exemple.fr
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
PLATFORM_ADMIN_TOKEN=

# Images construites depuis plateforme/ (voir en-tête de docker-compose.yml)
API_IMAGE=aussitot-api:latest
MIGRATE_IMAGE=aussitot-migrate:latest
API_REPLICAS=2
WEB_CONCURRENCY=2
# Export web de l'app (dossier servi par Caddy)
WEB_APP_DIR=./web

# Assistant (Claude)
ANTHROPIC_API_KEY=

# Emails transactionnels (devis, factures, relances)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=

# Fichiers (logos, PDF) : S3 ou compatible (Scaleway, OVHcloud, Clever Cloud…)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications push (Expo)
EXPO_ACCESS_TOKEN=
